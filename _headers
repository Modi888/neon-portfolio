# Netlify response headers. Cloudflare sits in front and caches by these.
# index.html stays uncached so a new ?v= in it reaches visitors right away;
# scripts and styles carry ?v= so a day of caching is safe; fonts never change.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/js/*
  Cache-Control: public, max-age=86400

/css/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800
